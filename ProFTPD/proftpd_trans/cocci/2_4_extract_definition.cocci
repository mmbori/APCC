//
// Coccinelle script to remove 'static' keyword and extract function declarations
//
// Generated by: 2_4_extract_definition.py
// Purpose: Remove static from assigned_fn functions and extract declarations
//
// This script:
// 1. Removes the static keyword from function definitions and declarations
// 2. Extracts function signatures and prints them to stdout
//
// Usage: spatch --sp-file <output.cocci> --dir <source_directory> 2>/dev/null
//        (Redirects diff output to /dev/null, only declarations go to stdout)

// Shared Python functions
@initialize:python@
@@
import os
import re
import sys

def clean_function_signature(signature):
    '''Clean up function signature formatting'''
    if not signature:
        return signature
    
    # Normalize all whitespace
    signature = re.sub(r'\s+', ' ', signature.strip())
    
    # Remove all spaces around asterisks first
    signature = re.sub(r'\s*\*\s*', '*', signature)
    
    # Add space before asterisk groups
    signature = re.sub(r'(\w)(\*+)', r'\1 \2', signature)
    
    # Clean up double spaces
    signature = re.sub(r'\s+', ' ', signature)
    
    return signature.strip()

def extract_and_print_signature(signature, func_name):
    '''Extract and print function signature to stdout'''
    clean_signature = clean_function_signature(signature)
    # Only print to stdout (will be captured by redirection)
    print(f"{clean_signature}")
    # Debug info goes to stderr
    print(f"[EXTRACTED] {func_name}: {clean_signature}", file=sys.stderr)



// ============================================================
// Rules for function: act_cb
// ============================================================

// Rule 1: Remove static from function definitions with explicit return type
@remove_static_act_cb_def@
type T;
identifier F = act_cb;
parameter list P;
@@
- static T F(P)
+ T F(P)
{
  ...
}

@script:python depends on remove_static_act_cb_def@
T << remove_static_act_cb_def.T;
F << remove_static_act_cb_def.F;
P << remove_static_act_cb_def.P;
@@
# Clean up parameter list
params = P
if ',' in params:
    param_list = [p.strip() for p in params.split(',')]
    params = ', '.join(param_list)

# Clean up type
type_str = T.strip()

# Extract and print signature
extract_and_print_signature(f"{type_str} {F}({params});", F)


